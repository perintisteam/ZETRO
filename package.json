{
  "name": "zetro",
  "version": "1.0.0",
  "description": "Screen recorder with mic and webcam overlay",
  "main": "main.js",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./assets/styles.css",
    "dev": "npm run build:css && electron .",
    "watch:css": "tailwindcss -i ./src/input.css -o ./assets/styles.css --watch",
    "screenshots": "npm run build:css && node scripts/capture-screenshots.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "electron": "^42.1.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.8",
    "tailwindcss": "^4.1.8"
  }
}
